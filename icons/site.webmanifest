{
  "name": "Jimpitan Digital",
  "short_name": "Jimpitan",
  "description": "Sistem Iuran Harian dengan Kredit Otomatis - Bayar Mendahului & Auto Debit",
  "start_url": "/bankflow-jimpitan/",
  "display": "standalone",
  "background_color": "#0a1628",
  "theme_color": "#0a1628",
  "orientation": "portrait",
  "scope": "/bankflow-jimpitan/",
  "lang": "id",
